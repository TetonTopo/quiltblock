# Copy to .env for local development. Never commit the real file.
#
# The Anthropic key is read ONLY by netlify/functions/generate.js, which runs on
# the server. It is never sent to the browser. If this is unset the storefront
# falls back to a local stand-in generator and says so on screen.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5.
QUILTBLOCK_MODEL=

# Optional limits and switches - see docs/deploying.md for all of them.
# QUILTBLOCK_ACCESS_CODE=
# QUILTBLOCK_PER_IP_HOURLY=6
# QUILTBLOCK_DAILY_CAP=60
# QUILTBLOCK_EFFORT=medium

# Payment is mocked; nothing reads these yet. They are here to show where a
# processor's secret would go when checkout is built for real.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
